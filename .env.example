# 替换为中间件部署根地址和 platform.yaml 中 knowledge-accumulation 对应的密钥。
# 地址与密钥同时留空可禁用接入；仅填写一项会阻止启动。
MIDDLEWARE_BASE_URL=http://127.0.0.1:22000
MIDDLEWARE_PLATFORM_CODE=knowledge-accumulation
MIDDLEWARE_SECRET=replace-with-platform-secret
# 登录可能等待消息客户端初始化约 30 秒，超时需覆盖该耗时。
MIDDLEWARE_REQUEST_TIMEOUT_SECONDS=40
MIDDLEWARE_RETRY_INTERVAL_SECONDS=30

# 启动自动按用户表→管理员表同步；首次登录缺资料时受控补登记，无独立启停开关。
# 必须使用与 registry 相同的权威人员源；完整范围及跨后端覆盖保护由部署侧保证。
MIDDLEWARE_USER_SYNC_OPERATION_TIMEOUT_SECONDS=30
MIDDLEWARE_USER_SYNC_RETRY_INTERVAL_SECONDS=30

# 登录作为核心能力直接装配；按 APP_ENV 配置开发凭据或生产钉钉凭据。
APP_ENV=development
# development 模式必填；作为 POST auth/login 的固定 Bearer 登录凭据。
# 该凭据须交换新随机用户 token；GET auth/me 只查中央，不会据此登录。
AUTH_DEVELOPER_ACCESS_TOKEN=
# 用户 token 的有效期与续期由中央控制，不配置本地 TTL。
AUTH_OPERATION_TIMEOUT_SECONDS=60
AUTH_MIDDLEWARE_TIMEOUT_SECONDS=5
# 开发 userid 绑定 SQL 员工时，以 SQL 姓名/权限/管理员关系为准；以下展示配置仅用于尚未落库的模拟身份。
AUTH_DEVELOPER_USERID=developer
AUTH_DEVELOPER_NAME=开发模拟用户
AUTH_DEVELOPER_DEPARTMENT_ID=0
AUTH_DEVELOPER_DEPARTMENT_NAME=开发模拟部门
AUTH_DEVELOPER_AVATAR_PATH=
AUTH_DEVELOPER_PERMISSIONS='{"registry":0}'
AUTH_DEVELOPER_MANAGED_PLATFORMS='[]'
# production 模式三项必填；只能填写本项目真实部署凭据，不复制其他项目实际 .env。
DINGTALK_CORP_ID=
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=
DINGTALK_TIMEOUT_SECONDS=10

# 单聊机器人：复用上方钉钉应用凭据；ASSISTANT_ENABLED 统一控制 Stream 入站、消费和发送。
# RobotCode 从同一应用机器人配置获取，不默认猜测为 AppKey。
DINGTALK_ROBOT_CODE=
# 接收器仅负责可靠入队，不在回调中等待模型生成。
DINGTALK_ROBOT_CALLBACK_TIMEOUT_SECONDS=10
DINGTALK_ROBOT_RECONNECT_MAX_SECONDS=60
DINGTALK_ROBOT_MAX_PENDING_CALLBACKS=16
DINGTALK_ROBOT_MAX_FRAME_BYTES=1048576
DINGTALK_ROBOT_MAX_IMAGE_PIXELS=40000000
DINGTALK_ROBOT_MAX_IMAGE_FRAMES=100
DINGTALK_ROBOT_MAX_DOWNLOAD_BYTES=52428800
DINGTALK_ROBOT_DOWNLOAD_ALLOWED_HOSTS=dingtalk.com,alicdn.com,aliyuncs.com

# 助理队列传输：复用 MIDDLEWARE_BASE_URL 和已有平台会话；消费者由下方 ASSISTANT_ENABLED 控制。
ASSISTANT_QUEUE_TIMEOUT_SECONDS=40
ASSISTANT_QUEUE_MAX_FILES=10
ASSISTANT_QUEUE_MAX_FILE_BYTES=20971520
ASSISTANT_QUEUE_MAX_RESPONSE_BYTES=1048576

# 助理消费与交付：手工完成 schema/011、012、014（目录查询另需 013），配置中间件、MLLM 和机器人后再启用。
# 本开关同时启用钉钉 Stream 入站、提醒和空闲心跳调度。
ASSISTANT_ENABLED=false
ASSISTANT_POLL_SECONDS=3
# 尚未生成时模型分词服务暂不可用：保留任务，间隔重试，不确认消费。
ASSISTANT_MODEL_RETRY_SECONDS=30
# 可靠入站：整条消息暂存后确认；待发布/拒绝提示的扫描和重试。
ASSISTANT_INBOUND_POLL_SECONDS=3
ASSISTANT_INBOUND_RETRY_SECONDS=30
ASSISTANT_INBOUND_BATCH_SIZE=100
# 扫描频率；每用户实际心跳间隔取 assistants.heartbeat_interval_seconds，默认 -1 关闭。
ASSISTANT_HEARTBEAT_POLL_SECONDS=30
# 提醒扫描间隔、每批处理数量与发布重试间隔。
ASSISTANT_REMINDER_POLL_SECONDS=3
ASSISTANT_REMINDER_BATCH_SIZE=100
ASSISTANT_REMINDER_RETRY_SECONDS=30
# 每任务独立的助理查询结果 LRU：结果集数量、每页条数、单次最多保存条数。
ASSISTANT_DIRECTORY_CACHE_CAPACITY=10
ASSISTANT_DIRECTORY_PAGE_SIZE=10
ASSISTANT_DIRECTORY_MAX_RESULTS=1000
ASSISTANT_MAX_CONCURRENT_USERS=4
ASSISTANT_THINKING_EFFORT=medium
# 最终正文转换子智能体独立档位，始终启用原生推理；low / medium / xhigh。
ASSISTANT_RENDERING_THINKING_EFFORT=medium
# 必须小于中间件发布幂等回执保留期；超出此窗口的未知发布结果停止自动重试。
ASSISTANT_PUBLICATION_RETRY_WINDOW_SECONDS=3600

# 连接池惰性创建；启动同步与已配置的记忆向量化会查询 MySQL，表由部署侧提前准备，不自动执行 DDL。
# 下列为占位命名；正式全表注册必须与 registry 权限编辑读取同一权威人员库/表，不能使用分叉副本。
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=knowledge_accumulation
MYSQL_USER=knowledge_accumulation
MYSQL_PASSWORD=
MYSQL_CONNECT_TIMEOUT_SECONDS=5
MYSQL_OPERATION_TIMEOUT_SECONDS=10

# 仅真实运行允许使用 data/user/avatar，测试须显式覆盖为 tests/tmp 下目录。
AVATAR_ROOT=data/user/avatar
AVATAR_MAX_DOWNLOAD_BYTES=10485760
AVATAR_MAX_PIXELS=16000000
AVATAR_TIMEOUT_SECONDS=10
AVATAR_ALLOWED_HOSTS=dingtalk.com,alicdn.com,aliyuncs.com

# 仅探索模式：中途反馈提醒间隔（秒，可为小数）；0关闭，默认60。成功emit_progress后重计，不打断运行中的模型或工具。
AGENT_PROGRESS_REMINDER_INTERVAL_SECONDS=60
# 以下 AGENT_* 容量、分页、展示轮次和图片预算以配置为准，只校验正整数，不另设代码最大值。
# Agent 文件模型 LRU 容量：每个服务自建池最多驻留的文件数，不是图片页数。
AGENT_FILE_CACHE_MAX_FILES=4
# 可折叠正文存活轮次：每次打开后可见的完整主模型响应次数，不是同时存在的图片数。
# 两项均为正整数；模式工厂构造时读取，修改后须重建服务或重启进程。
AGENT_PAGE_DISPLAY_ROUNDS=5

# 每棵用户问答树驻留的专家会话数；LRU 只驱逐空闲会话。
AGENT_EXPERT_SESSION_CACHE_MAX_SESSIONS=10

# 外部专家：独立于 vLLM，通过 Responses 使用服务端内置搜索。
# Key 留空不影响启动；首次求助时明确反馈未配置，不发请求。
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro
# none / low / high / max；与用户本轮主模型的三档强度独立。
DEEPSEEK_REASONING_EFFORT=high
DEEPSEEK_TIMEOUT_SECONDS=300
DEEPSEEK_MAX_CONCURRENT_REQUESTS=3
DEEPSEEK_MAX_COMPLETION_TOKENS=8192

# 网页检索：共用 DEEPSEEK_BASE_URL/API_KEY，搜索与专家生成预算独立。
DEEPSEEK_SEARCH_TIMEOUT_SECONDS=45
DEEPSEEK_SEARCH_COUNT=10
DEEPSEEK_SEARCH_TRUST_ENV=false
# 每棵用户树的搜索/正文 LRU 容量及分页；正文与搜索页沿用 AGENT_PAGE_DISPLAY_ROUNDS。
AGENT_WEB_SEARCH_CACHE_MAX_QUERIES=10
AGENT_WEB_SEARCH_PAGE_SIZE=5
AGENT_WEB_SEARCH_MAX_CONCURRENT_REQUESTS=2
AGENT_WEB_PAGE_CACHE_MAX_ENTRIES=10
AGENT_WEB_PAGE_CHARS=3000
# 网页图像只在当前任务内存驻留；候选数、保留数、单图下载/标准化字节上限。
# 具体读取数量仍受下载和相关性筛选影响。
AGENT_WEB_IMAGE_MAX_CANDIDATES=6
AGENT_WEB_IMAGE_MAX_SELECTED=3
AGENT_WEB_IMAGE_MAX_BYTES=4194304

# 多模态主模型 vLLM：填写部署根地址或 /v1 地址；模型名须匹配服务的 served-model-name。
# 默认模型名及生成参数参考 contract-service-be；如服务别名不同请修改 MODEL。
# 探索问答 HTTP/SSE 按需装配模型；留空不影响身份接口，提交问答时返回不可用。
VLLM_MLLM_PROVIDER=vllm
VLLM_MLLM_ENDPOINT=chat_completions
VLLM_MLLM_BASE_URL=
VLLM_MLLM_MODEL=qwen38-flash-next
# 可选工具格式说明；关闭不读取文件、不改变原生 tools 或推理强度映射。
# 文件位于 assets/tool-tag，须匹配服务端模型、chat template 与 tool-call parser。
VLLM_MLLM_TOOL_TAG_ENABLED=true
VLLM_MLLM_TOOL_TAG_FILE=qwen3.8-flash-next-nvfp4.txt
VLLM_MLLM_API_KEY=
VLLM_MLLM_TIMEOUT_SECONDS=300
VLLM_MLLM_MAX_CONCURRENT_REQUESTS=20
VLLM_MLLM_CONTEXT_WINDOW_TOKENS=262144
VLLM_MLLM_ENABLE_THINKING=true
# 摘要主题发现/总结固定读取此配置；主任务仍由用户请求选择推理档位。
VLLM_MLLM_REASONING_EFFORT=xhigh
VLLM_MLLM_TEMPERATURE=0.7
VLLM_MLLM_TOP_P=0.8
VLLM_MLLM_TOP_K=20
VLLM_MLLM_PRESENCE_PENALTY=1.5
VLLM_MLLM_REPETITION_PENALTY=1.0
VLLM_MLLM_SEED=3407
VLLM_MLLM_MAX_COMPLETION_TOKENS=8192

# 向量模型 vLLM：填写地址即可使用默认模型；如服务别名不同请修改 MODEL。
# 配置地址后启动后台记忆向量化；留空不启用，已有 pending/failed 在配置后补处理。
# API key 无需认证时留空；更换模型或编码指令须显式重建历史向量。
VLLM_EMBEDDING_PROVIDER=vllm
VLLM_EMBEDDING_ENDPOINT=embeddings
VLLM_EMBEDDING_BASE_URL=
VLLM_EMBEDDING_MODEL=qwen3-vl-embedding-8b
# 须与 MyVector 索引列声明维度一致；更换模型需清理索引并重建全部记忆向量。
VLLM_EMBEDDING_DIMENSIONS=4096
VLLM_EMBEDDING_API_KEY=
VLLM_EMBEDDING_TIMEOUT_SECONDS=60
VLLM_EMBEDDING_BATCH_SIZE=32
VLLM_EMBEDDING_MAX_CONCURRENT_REQUESTS=10
VLLM_EMBEDDING_NORMALIZE=true

# 终态任务的公开消息分批加工；原生推理、工具回执和中断输出不参与。
MEMORY_EMBEDDING_BATCH_SIZE=32
MEMORY_EMBEDDING_SCAN_INTERVAL_SECONDS=30

# 当前问答内的记忆查询驻留和分页；任务结束释放，页面沿用 AGENT_PAGE_DISPLAY_ROUNDS 自动折叠。
AGENT_MEMORY_CACHE_MAX_QUERIES=10
AGENT_MEMORY_PAGE_SIZE=3

# 注册中心文件查询：只读resources与employees，绝不读取其他项目.env。
# database默认registry；其他连接项留空复用本项目MYSQL_*，也可配置独立只读账号。
FILE_SOURCE_MYSQL_DATABASE=registry
FILE_SOURCE_MYSQL_HOST=
FILE_SOURCE_MYSQL_PORT=
FILE_SOURCE_MYSQL_USER=
FILE_SOURCE_MYSQL_PASSWORD=
# 派生文件检索数据只在内存中；不建检索表，不依赖MyVector。
# 名称采用MySQL全文检索，摘要额外使用现有VLLM_EMBEDDING_*与MyVector精确距离。
FILE_RETRIEVAL_TOP_K=10
FILE_RETRIEVAL_CANDIDATE_MULTIPLIER=4
FILE_RETRIEVAL_CACHE_MAX_QUERIES=10
# 每进程保留的摘要向量数量；不限制单次授权候选范围，进程退出释放。
FILE_RETRIEVAL_CACHE_MAX_VECTORS=256
FILE_RETRIEVAL_PAGE_SIZE=5
FILE_RETRIEVAL_MAX_ROUNDS=16
FILE_RETRIEVAL_RRF_K=60
FILE_RETRIEVAL_HISTORY_WEIGHT=0.5

# 注册中心文件查看：填写HTTP/HTTPS根地址，路径由客户端固定拼接。
# 复用中间件平台会话认证，按可信任务userid读取；无独立下载密钥，留空时工具提示未配置。
REGISTRY_BASE_URL=
REGISTRY_FILE_TIMEOUT_SECONDS=60
REGISTRY_FILE_MAX_DOWNLOAD_BYTES=52428800
# PDF模型驻留和图像展示轮数复用AGENT_FILE_CACHE_MAX_FILES、AGENT_PAGE_DISPLAY_ROUNDS。

# 跨平台 A2A：启用前手工执行 schema/018-platform-a2a.sql；复用现有平台会话。
# 单进程共享接收器服务探索和个人助理；不会直接连接其他平台或自动创建表。
PLATFORM_A2A_ENABLED=false
# 首次广播（包括单目标）发布成功后，先缓冲再读取；等全体终态或整轮到期返回。
PLATFORM_A2A_RESPONSE_BUFFER_SECONDS=5
PLATFORM_A2A_WAIT_SECONDS=90
PLATFORM_A2A_POLL_SECONDS=1
PLATFORM_A2A_HTTP_TIMEOUT_SECONDS=10
PLATFORM_A2A_MAX_CONCURRENT_REQUESTS=16
